# OriginChain local demo authentication configuration.
# Generate a unique value for each environment. Never use this example in production.
ORIGINCHAIN_JWT_SECRET=replace-with-a-long-random-local-secret
ORIGINCHAIN_ACCESS_TOKEN_MINUTES=30

# Enables presentation-only Auto-Fill, HOLD, readiness, reset, and tamper controls.
# Set to 0 anywhere outside the local university demonstration.
ORIGINCHAIN_DEMO_MODE=1

# Existing optional local paths.
# ORIGINCHAIN_RPC_URL=http://127.0.0.1:8545
# ORIGINCHAIN_DB_PATH=backend/originchain_demo.sqlite3
# ORIGINCHAIN_UPLOAD_DIR=backend/uploads
